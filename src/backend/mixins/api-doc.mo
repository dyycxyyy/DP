/// Static behavioural API documentation for the backend.
///
/// `getApiDoc` returns a Markdown document authored from the current backend
/// source. It reads no state, so it is a pure `query` and the document is a
/// literal returned directly from the function body.
mixin () {
  /// Markdown description of the public API: methods, authorization, units,
  /// round lifecycle, polling guidance, retry safety and error variants.
  public query func getApiDoc() : async Text {
    "# 博弈终端后端 API 文档\n\n本后端实现一个由玩家行为聚合生成开奖号码的 7 位数字博弈游戏。\n\n## 一、单位与编码\n\n- **Lucky**：整数 `Nat`，无小数位。\n- **ICP**：以 e8s 表示（`Nat`，1 ICP = 100_000_000 e8s）。\n- **时间戳**：IC 时间，单位纳秒（`Int`），自 Unix 纪元起算。\n- **号码**：`[Nat]`，恰好 7 位，每位 0-9，允许前导零。\n- **位置**：`Nat`，1-7；众筹仅涉及第 1-3 位。\n- **金额上限**：单次众筹最多 100_000 Lucky；单次 ICP→Lucky 兑换 0.1-10_000 ICP；单次 Lucky→ICP 兑换最多 10_000_000 Lucky（3% Lucky 手续费）。\n\n## 二、身份与授权\n\n- **匿名可读**：所有 `query` 读取方法无需登录，匿名调用者也可读取。\n- **写方法**：以调用者 principal 记账。首次接触时后端惰性创建零余额账户，因此无需单独的注册步骤。\n- **管理员身份模型**：管理员由平台应用级授权角色决定，而非 canister controller 身份。角色为 `#admin` / `#user` / `#guest`。\n- **注册前置条件**：调用者必须先通过本应用前端登录一次，才会被注册进角色表。首位通过部署链接（admin token）登录的已登录调用者自动获得 `#admin`；此后登录的调用者获得 `#user`。从未通过本应用前端登录的 principal（即使它属于应用所有者）在角色表中不存在，因此不是管理员。\n- **管理员判定**：`isCallerAdmin()`（由授权包提供）返回调用者是否持有 `#admin` 角色。`getCallerRole()` 返回调用者自身角色（未注册的非控制器返回 `#guest`）。\n- **控制器恢复**：canister controller 始终被视为管理员，即使角色表丢失或从未注册，以便恢复应用。\n- **管理端点**：`stopNextRound`、`resumeRound`、`withdrawFromPool`、`resetGameData`、`setGuideText`、`devSeedBalance`、`devAdvanceRound`、`devSetRoundElapsed`、`getDailyStats`、`listUsers`、`promoteToAdmin`、`demoteToUser` 仅限管理员；非管理员调用返回 `#notRegistered`（`listUsers`/`promoteToAdmin`/`demoteToUser` 返回 `#err(#notRegistered)`）。\n- **用户管理**：`listUsers()` 列出所有已注册 principal 及其角色；`promoteToAdmin(user)` 将目标提升为 `#admin`；`demoteToUser(user)` 将目标降为 `#user`。目标为匿名 principal 时返回 `#err(#invalidRecipient)`。\n- **身份派生**：本应用前端固定 Internet Identity 派生来源（derivation origin），并在可用时于 `/.well-known/ii-derivation-origin` 公布。已持有用户 Internet Identity 授权的 agent 会针对该来源派生出正确的每应用 principal（例如 `icp identity link web <name> --app <host>`）。该委派在过期前拥有用户在本应用中的完整权限，请谨慎使用。\n- **未注册调用者**：从未通过本应用前端登录的 principal（即使它属于应用所有者）在写方法上会被惰性创建为零余额账户，随后因余额不足返回 `#insufficientBalance`；在 `getMyProfile` 上得到零值档案。\n\n## 三、公开方法\n\n### 读取（query，无调用成本）\n\n- `getGameState() : GameState` — 当前局状态：局号、阶段、各阶段截止时间、总奖池、众筹总额、国库余额、兑换池余额、中奖号码（开奖后）、`roundStopped` 以及第 1-3 位每个数字的众筹明细。\n- `getTopBetNumbers() : [TopBetNumber]` — 本期投注次数最多的前 10 组号码，按次数降序、次数相同按号码数值升序。返回号码互不重复：某号码的 `ticketCount` 为其单式/批量注数加上包含该号码的复式提交数（重叠时累加），与逐注记录一致。\n- `getDrawResult(round : Nat) : ?DrawResult` — 指定局的开奖结果：中奖号码、各奖项中奖注数与单注奖金，以及调用者本人在该局的中奖金额与最高奖项。局不存在时返回 `null`。\n- `getRoundHistory(limit : Nat) : [RoundHistoryEntry]` — 最近完成的局，最新在前；`limit` 上限为 50。每期含 `positions`：第 1-3 位开奖依据（胜出数字、该数字最终金额、是否由阈值锁定、各数字最终金额），与开奖号码第 1-3 位同源。\n- `getExchangePoolState() : ExchangePoolState` — 兑换池的 ICP（e8s）与 Lucky 余额。\n- `getTreasuryBalance() : Lucky` — 国库 Lucky 余额。\n- `getGuideText() : GuideText` — 管理员保存的玩法说明：`text` 为正文（未设置时为空串），`isSet` 表示是否已保存过非空内容。\n- `isCallerController() : Bool` — 已弃用别名：调用者是否为管理员（平台 `#admin` 角色或 canister controller）。新代码请使用 `isCallerAdmin()`。\n- `isCallerAdmin() : Bool` — 调用者是否持有平台 `#admin` 角色（或为 canister controller）。\n- `getCallerRole() : UserRole` — 调用者自身的平台角色（`#admin` / `#user` / `#guest`）。\n- `listUsers() : AdminUserListOutcome` — 列出所有已注册 principal 及其角色。仅管理员；非管理员返回 `#err(#notRegistered)`。\n- `getAdminStatus() : AdminStatus` — 管理快照：`roundStopped` 与四个可提取池的余额（`prizePool`、`treasury`、`exchangeLucky`、`exchangeIcp`）。\n- `getDailyStats(fromDate : Text, toDate : Text) : DailyStatsOutcome` — 按自然日（UTC）统计的区间数据，`fromDate`/`toDate` 为 `YYYY-MM-DD`，闭区间。每天返回 `totalBets`（当日所有玩家购票花费合计）、`totalPayouts`（当日所有中奖派彩合计）、`treasuryIncome`（当日奖池封顶溢出转入国库的金额）。无数据的日期返回零值而非省略。区间上限 366 天；日期格式错误或区间倒置返回 `#err(#invalidAmount)`，区间过长返回 `#err(#amountTooLarge)`。**仅管理员可见**，非管理员返回 `#err(#notRegistered)`。\n- `getMyProfile() : PlayerProfile` — 调用者自己的有界档案：Lucky 余额、身份、上次操作时间、剩余冷却毫秒数、投注/中奖总记录数。未注册调用者得到零值档案。\n- `getMyBetHistory(offset : Nat, limit : Nat) : BetHistoryPage` — 调用者投注历史的一页，最新在前；`limit` 服务端上限 50，`nextOffset` 为 `null` 表示已到末页。\n- `getMyWinHistory(offset : Nat, limit : Nat) : WinHistoryPage` — 调用者中奖历史的一页，规则同上。\n- `getDepositAddress() : DepositAddress` — 调用者自己的 ICP 充值地址（canister principal + 由调用者 principal 派生的每用户 subaccount），含 `accountText` 规范文本。\n- `getRecentTransfers() : [WalletTransferRecord]` — 调用者最近的转账记录，最新在前，每用户最多保留 20 条。\n- `schema() : Text` / `execute(query : Text) : Text` — OQL 数据查询接口（由 `Expose` mixin 提供）。`schema()` 返回可查询实体及其列的 JSON 描述；`execute()` 接受 JSON 查询并返回 JSON 行。实体授权各自独立：`roundHistory` 公开可读；`player`、`walletTransfer` 为 controllerOrScoped（控制器读全部，登录用户仅读自己的行）；`dailyStats`、`userRole`、`luckyBlock`、`luckyBalance` 仅控制器可读。`userRole` 实体暴露平台角色注册表（`principal` 与 `role` 两列，`role` 为 `admin`/`user`/`guest` 文本），仅控制器与数据智能体可读，普通用户不可读。`luckyBlock` 实体暴露 Lucky 账本交易日志（`index`、`timestamp`、`from`、`to`、`amount`、`fee`、`memo`、`kind` 列，`kind` 为 `mint`/`transfer`/`approve`/`transferFrom` 文本，`from`/`to` 为规范账户文本，mint 的缺失一侧为 `-`）；`luckyBalance` 实体暴露每个账户的 Lucky 余额（`account` 规范账户文本与 `balance` 两列）。两者均仅控制器与数据智能体可读，普通用户不可读。\n\n### 写入（update，产生调用成本）\n\n- `placeBet(number : [Nat], count : Nat) : GameError` — 在 7 位号码上投 `count` 注，1 Lucky/注，仅投注阶段。\n- `placeBets(numbers : [[Nat]], counts : [Nat]) : GameError` — 一次提交多个不同号码，各带注数；两数组长度必须相同且非空，每个 count >= 1。一次 3 秒冷却、一次合计扣款。\n- `placeBetSelections(selections : [[Nat]], counts : [Nat]) : GameError` — 复式投注：`selections` 为 7 个位置各自的选号集合，`counts` 为各位置选号个数，总注数为各位置个数之积。后端自行展开笛卡尔积，前端无需物化。一次 3 秒冷却、一次合计扣款。\n- `contributeCrowdfund(position : Nat, digit : Nat, amount : Lucky) : GameError` — 向第 `position`（1-3）位的数字 `digit` 众筹 `amount` Lucky；投注或众筹阶段可用，单次最多 100_000。\n- `exchangeIcpToLucky(icpE8s : Nat) : GameError` — 按固定 1 ICP = 1000 Lucky 兑换，无手续费；0.1-10_000 ICP，且为 0.1 ICP 的整数倍。\n- `exchangeLuckyToIcp(luckyAmount : Lucky) : GameError` — 反向兑换，收取 3% Lucky 手续费（流入国库）；输入须为 1000 的正整数倍，最多 10_000_000。\n- `transferIcp(recipient : Principal, amount : Nat) : GameError` — 从调用者余额向任意 principal 发送 ICP（e8s），校验余额与账本手续费（0.0001 ICP）。\n- `transferLucky(recipient : Principal, amount : Lucky) : GameError` — 向另一 principal 转账 Lucky。\n\n### 管理（update，仅管理员）\n\n- `stopNextRound() : GameError` — 停止当前/下一局：在恢复前不接受新投注与众筹。\n- `resumeRound() : GameError` — 恢复被停止的局。\n- `withdrawFromPool(pool : AdminPool, amount : Nat, recipient : Principal) : AdminWithdrawOutcome` — 从指定池提取代币给 `recipient`。`pool` 为 `#prizePool` / `#treasury` / `#exchangeLucky` / `#exchangeIcp`；金额以该池的基础单位计（Lucky，ICP 为 e8s）。池被借记、收款人 Lucky 余额被贷记，总供应守恒。拒绝零金额、匿名收款人与超额提取。\n- `resetGameData() : AdminResetOutcome` — 重置全部游戏数据：清空奖池、国库、兑换池、玩家账户、tally、复式投注、top-K、开奖记录、历史与转账记录，局号回到 1。停止标志与玩法说明文本作为配置被保留；每日统计作为历史记录同样被保留，不会被清空。\n- `setGuideText(text : Text) : GameError` — 保存玩法说明文本（最多 20_000 字符）。\n- `promoteToAdmin(user : Principal) : AdminRoleChangeOutcome` — 将 `user` 提升为 `#admin`。仅管理员；目标为匿名 principal 时返回 `#err(#invalidRecipient)`。\n- `demoteToUser(user : Principal) : AdminRoleChangeOutcome` — 将 `user` 降为 `#user`。仅管理员；目标为匿名 principal 时返回 `#err(#invalidRecipient)`。\n- `devSeedBalance(amount : Nat) : GameError` — 给调用者自己贷记 `amount` Lucky（仅管理员）。\n- `devAdvanceRound() : GameError` — 快进本局时钟，使其完成整个周期（仅管理员）。\n- `devSetRoundElapsed(elapsedNs : Int) : GameError` — 将本局已过时间设为 `elapsedNs`，用于确定性测试（仅管理员）。\n\n## 四、局生命周期与轮询\n\n一局按固定窗口推进（自 `roundStart` 起算）：\n\n1. **投注阶段**（0-300 秒）：接受 `placeBet` / `placeBets` / `placeBetSelections`，也接受众筹。\n2. **众筹阶段**（300-480 秒）：仅接受 `contributeCrowdfund`。\n3. **开奖阶段**（480-510 秒）：众筹截止后由惰性 `advance` 执行开奖与派奖。\n4. **派奖阶段**（510-540 秒）：观察窗口。\n\n- 轮次推进是**惰性**的：没有定时器，`advance` 在每个公开入口顶部调用，使用 IC 时间关闭已过阶段、在众筹截止后执行开奖与派奖、并在观察窗口后开启下一局。`advance` 幂等，重复调用不会重复开奖。\n- `getGameState()` 返回 `phase` 与 `phaseDeadline`（当前阶段截止时间戳）、`bettingDeadline`、`crowdfundingDeadline`，前端应据此自适应轮询频率：投注/众筹阶段可较慢轮询，临近截止或开奖/派奖阶段可加快。\n- 只读数据一律通过 `query` 获取，不产生更新调用成本；写操作仅在用户主动提交时触发，提交后仅刷新受影响的数据。\n\n## 五、变更重试安全与幂等性\n\n- **投注/众筹/兑换/转账**：非幂等。每次成功调用都会扣款并记账；重复提交会重复扣款。前端应在收到 `#ok` 后停止重试，并在失败时依据错误变体决定是否重试。\n- **`#rateLimited`**：同一调用者两次游戏动作之间强制 3 秒间隔（投注与众筹共享该冷却；兑换与钱包转账不受此冷却限制）。收到该错误时应等待 `remainingMs` 后再重试。\n- **`resetGameData`**：破坏性操作，清空全部游戏数据，不可撤销。\n- **`withdrawFromPool`**：非幂等，重复调用会重复提取。\n- **`setGuideText`**：幂等覆盖，重复保存同一文本结果相同。\n- **`stopNextRound` / `resumeRound`**：幂等设置标志。\n\n## 六、错误与陷阱\n\n所有写方法返回共享的 `GameError` 变体（管理提取/重置返回 `AdminWithdrawOutcome` / `AdminResetOutcome`，其 `#err` 携带同一 `GameError`）：\n\n- `#ok` — 成功。\n- `#phaseClosed({ current, required })` — 当前阶段不允许该动作。\n- `#insufficientBalance({ required, available })` — Lucky 余额不足。\n- `#invalidAmount({ step })` — 金额非正或不是 `step` 的整数倍。\n- `#amountTooLarge({ max })` / `#amountTooSmall({ min })` — 超出单次上下限。\n- `#rateLimited({ remainingMs })` — 3 秒动作间隔未过。\n- `#poolInsufficient({ token, available })` — 目标池余额不足。\n- `#invalidBetNumber` — 号码不是 7 位 0-9。\n- `#invalidPosition` — 众筹位置不在 1-3 或数字不在 0-9。\n- `#roundNotFound({ round })` — 请求的局无数据。\n- `#notRegistered` — 调用者非控制器（管理端点）或未注册。\n- `#ledgerUnavailable({ reason })` — ICP 账本不可达或拒绝转账。\n- `#invalidRecipient` — 收款 principal 无效（匿名、或转账给自己/canister）。\n- `#roundStopped` — 管理员已停止当前/下一局：在恢复前不接受新投注与众筹。\n\n**非显而易见的陷阱：**\n\n- 众筹在投注阶段**和**众筹阶段都可用；`contributeCrowdfund` 的 `required` 字段为 `#crowdfunding`，但投注阶段同样接受。\n- 复式投注的 `ticketCount` 是各位置选号个数之积，可能极大（如 10^7）；后端以有界结构存储，不会物化笛卡尔积。\n- 开奖号码第 1-3 位来自众筹（锁定数字优先，否则金额最高者，平局取较大数字）；第 4-5 位来自开奖前总奖池的十位/个位；第 6-7 位来自众筹总额的十位/个位。\n- 奖池超过 99_999_900 的部分在开奖时转入国库。\n- `getWalletBalances()` 是 **update** 调用（需查询 ICP 账本），不是 query。\n- `getDepositAddress()` 是 query，但充值到账需账本确认后才反映在余额中。\n- 转账记录每用户最多保留 20 条，超出后最旧的被丢弃。\n- 局历史最多保留 50 期；每用户每局中奖记录保留窗口为 50 局。\n- 管理端点仅限管理员（平台 `#admin` 角色或 canister controller）；普通用户即使通过前端登录也无法调用。\n- 每日统计按 UTC 自然日聚合，在投注与开奖派奖的写入点累加，因此数值精确且无需扫描历史；`resetGameData` 不会清除每日统计。\n\n## 四、Lucky 代币账本（ICRC-1 / ICRC-2）\n\nLucky 同时是一个真正的链上代币账本，实现 ICRC-1 基础标准与 ICRC-2 授权扩展，并提供 ICRC-3 交易日志。\n\n### 单位与元数据\n\n- **名称**：`Lucky`；**符号**：`LUCKY`；**小数位**：0；**转账手续费**：0。\n- **图标**：`icrc1:logo` 元数据内嵌四叶草图标的 `data:` URL。\n- **总量**：无上限。`icrc1_total_supply()` 等于累计铸造量；本账本不提供销毁（burn）。\n- **账户**：`{ owner : Principal; subaccount : ?Blob }`。省略 subaccount 时使用 owner 的默认账户。\n\n### ICRC-1 核心方法\n\n- `icrc1_name()` / `icrc1_symbol()` / `icrc1_decimals()` / `icrc1_fee()` — 元数据读取（query）。\n- `icrc1_metadata()` — 完整元数据表，含 `icrc1:logo`（query）。\n- `icrc1_total_supply()` — 累计铸造总量（query）。\n- `icrc1_balance_of(account)` — 指定账户余额（query）。\n- `icrc1_transfer(arg)` — 从调用者账户转账到 `arg.to`；余额不足返回 `#Err(#InsufficientFunds)`，金额为 0 或转给自己返回 `#Err(#GenericError)`。\n- `icrc1_supported_standards()` — 声明 ICRC-1 与 ICRC-2 及其规范链接（query）。\n\n### ICRC-2 授权方法\n\n- `icrc2_approve(arg)` — 调用者授权 `arg.spender` 使用其账户额度。`expected_allowance` 用于并发保护：若与实际额度不符返回 `#Err(#AllowanceChanged)`；`expires_at` 已过期返回 `#Err(#Expired)`。\n- `icrc2_transfer_from(arg)` — 调用者作为 spender，从 `arg.from` 扣款转给 `arg.to`。额度不足返回 `#Err(#InsufficientAllowance)`，余额不足返回 `#Err(#InsufficientFunds)`；已过期的额度视为 0。\n- `icrc2_allowance(arg)` — 查询 `arg.spender` 对 `arg.account` 的额度；已过期额度返回 0 且 `expires_at` 为 `null`（query）。\n\n### ICRC-3 交易日志\n\n- `icrc3_get_blocks(start, length, account)` — 返回从 `start` 起最多 `length` 条（单页上限 100）交易，按索引升序。`account` 非空时仅返回与该账户相关的交易（作为 from 或 to）。`nextIndex` 为下一页起始索引，`null` 表示已到末尾。每条交易含 `index`、`timestamp`（纳秒）、`from`/`to`、`amount`、`fee`、`memo` 与 `kind`（`#mint` / `#transfer` / `#approve` / `#transferFrom`）。\n\n### 管理员铸造\n\n- `mintLucky(arg)` — 管理员向 `arg.to` 铸造任意数量 Lucky，无上限；成功返回区块索引与新的累计总量。非管理员返回 `#err(#notRegistered)`；金额为 0 返回 `#err(#invalidAmount)`。\n- `migrateInternalLucky(arg)` — 管理员将某玩家既有的游戏内 Lucky 余额铸造到其账本账户，使游戏内余额与账本余额一致。非管理员返回 `#err(#notRegistered)`；该玩家余额为 0 返回 `#err(#insufficientBalance)`。\n- `getTokenInfo()` — 代币元数据与当前总量快照（query）。\n- `getLedgerBalance()` — 调用者自身的账本余额与手续费（query）。\n\n### 集成注意事项\n\n- 账本余额与游戏内 `PlayerAccount.luckyBalance` 是两套独立记账；`migrateInternalLucky` 是二者对齐的显式操作，不会自动同步。\n- 转账、授权与铸造均为 update 调用；`icrc1_transfer` 与 `icrc2_transfer_from` 无幂等去重，重复调用会重复扣款，调用方需自行保证重试安全。\n- 所有金额为整数 Lucky，无小数位。\n";
  };
};
